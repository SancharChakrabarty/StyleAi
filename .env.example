# Copy this to .env and fill in your values.
# Never commit .env to Git.

# ── Vision model ─────────────────────────────────────────────────────────────
# Path to epoch_1.pt checkpoint (local path or HF Hub repo)
VISION_CHECKPOINT=models/vision/checkpoints/epoch_1.pt

# ── LLM backend ──────────────────────────────────────────────────────────────
# "local"  → load from LLM_MODEL_PATH (HuggingFace model directory)
# "ollama" → use a local Ollama server
LLM_BACKEND=local
LLM_MODEL_PATH=models/llm/merged

# ── Retriever ────────────────────────────────────────────────────────────────
TOP_K_TRENDS=5

# ── CORS (set to your Vercel frontend URL in production) ─────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
